@@ -0,0 +1,533 @@
+//! Experimental remote-V2 preparation concurrent with a normal turn.
+//! Publication is exclusively owned by the turn loop at a request boundary.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+use crate::compact::CompactedHistoryMetadata;
+use crate::compact::CompactionAnalyticsDetails;
+use crate::compact_remote_v2::PreparedRemoteCompaction;
+use crate::compact_remote_v2::RetainedImageBudget;
+use crate::compact_remote_v2::build_v2_compacted_history;
+use crate::compact_remote_v2::run_remote_compact_v2_snapshot_attempt;
+use crate::context::world_state::split_prefix_updates;
+use crate::context_manager::is_user_turn_boundary;
+use crate::context_manager::updates::merge_world_state_updates;
+use crate::hook_runtime::PostCompactHookOutcome;
+use crate::hook_runtime::PreCompactHookOutcome;
+use crate::hook_runtime::run_post_compact_hooks;
+use crate::hook_runtime::run_pre_compact_hooks;
+use crate::responses_metadata::CompactionTurnMetadata;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use codex_analytics::CompactionImplementation;
+use codex_analytics::CompactionPhase;
+use codex_analytics::CompactionReason;
+use codex_analytics::CompactionTrigger;
+use codex_features::Feature;
+use codex_history::ResponseItemEnvelope;
+use codex_model_provider::RemoteCompactionSupport;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::models::ResponseItem;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+use tracing::info;
+use tracing::warn;
+
+pub(crate) struct HistorySnapshot {
+    pub(crate) items: Arc<Vec<ResponseItemEnvelope>>,
+    pub(crate) protected_start: usize,
+    pub(crate) reset: CancellationToken,
+    pub(crate) window_id: String,
+    window_number: u64,
+    window_ids: crate::state::AutoCompactWindowIds,
+    pub(crate) max_estimated_tokens: i64,
+    pub(crate) fresh_context: Vec<ResponseItemEnvelope>,
+    pub(crate) pinned_user_items: Vec<ResponseItemEnvelope>,
+}
+
+struct Pending {
+    snapshot: HistorySnapshot,
+    step: Arc<StepContext>,
+    worker: JoinHandle<CodexResult<PreparedRemoteCompaction>>,
+}
+
+#[derive(Default)]
+pub(crate) struct BackgroundCompaction {
+    pending: Option<Pending>,
+    next_start_tokens: i64,
+    attempted: bool,
+    failures: u8,
+    window_id: Option<String>,
+    #[cfg(test)]
+    pub(crate) enabled_for_test: bool,
+    #[cfg(test)]
+    pub(crate) timeout_for_test: Option<Duration>,
+}
+
+impl Drop for BackgroundCompaction {
+    fn drop(&mut self) {
+        if let Some(pending) = self.pending.take() {
+            pending.worker.abort();
+        }
+    }
+}
+
+impl BackgroundCompaction {
+    #[cfg(test)]
+    pub(crate) fn is_preparing(&self) -> bool {
+        self.pending.is_some()
+    }
+
+    pub(crate) fn cancel(&mut self) {
+        if let Some(pending) = self.pending.take() {
+            pending.worker.abort();
+        }
+        self.attempted = false;
+    }
+
+    /// Never awaits an unfinished compaction. Native hard-limit compaction is left intact.
+    pub(crate) async fn at_request_boundary(
+        &mut self,
+        sess: &Arc<Session>,
+        step: &Arc<StepContext>,
+    ) -> CodexResult<bool> {
+        self.advance(sess, step, true).await
+    }
+
+    pub(crate) async fn publish_if_ready(
+        &mut self,
+        sess: &Arc<Session>,
+        step: &Arc<StepContext>,
+    ) -> CodexResult<bool> {
+        self.advance(sess, step, false).await
+    }
+
+    async fn advance(
+        &mut self,
+        sess: &Arc<Session>,
+        step: &Arc<StepContext>,
+        allow_start: bool,
+    ) -> CodexResult<bool> {
+        if !self.enabled() || step.turn.config.features.enabled(Feature::TokenBudget) {
+            self.cancel();
+            return Ok(false);
+        }
+        let mut installed = false;
+        let window_id = sess.current_window_id().await;
+        if self
+            .window_id
+            .as_ref()
+            .is_some_and(|previous| *previous != window_id)
+        {
+            self.cancel();
+            self.failures = 0;
+            self.next_start_tokens = 0;
+        }
+        self.window_id = Some(window_id);
+        if let Some(pending) = &self.pending
+            && (pending.snapshot.reset.is_cancelled()
+                || pending.snapshot.window_id != sess.current_window().await.2.to_string()
+                || pending.step.settings.model_info != step.settings.model_info)
+        {
+            self.cancel();
+            self.next_start_tokens = 0;
+            info!("background compaction cancelled after reset or model change");
+        }
+        if self
+            .pending
+            .as_ref()
+            .is_some_and(|pending| pending.worker.is_finished())
+        {
+            let pending = self.pending.take().expect("finished background compaction");
+            // Reject settings changes as well as transcript changes. A future attempt
+            // can use the new model; never apply a candidate made for a different one.
+            let same_model = pending.step.settings.model_info == step.settings.model_info;
+            match pending.worker.await {
+                Ok(Ok(candidate)) => {
+                    if same_model {
+                        match install(sess, step, pending.snapshot, candidate).await {
+                            Ok(published) => installed = published,
+                            Err(error)
+                                if matches!(
+                                    error.details(),
+                                    codex_protocol::error::CodexErrorDetails::TurnAborted
+                                ) =>
+                            {
+                                return Err(error);
+                            }
+                            Err(error) => {
+                                warn!(%error, "background publication failed; keeping live history");
+                            }
+                        }
+                    }
+                }
+                Ok(Err(error)) => {
+                    warn!(%error, "background compaction failed; keeping live history")
+                }
+                Err(error) => {
+                    warn!(%error, "background compaction worker failed; keeping live history")
+                }
+            }
+            if installed {
+                self.failures = 0;
+            } else {
+                self.failures = self.failures.saturating_add(1);
+            }
+            self.attempted = false;
+            self.next_start_tokens = sess.get_total_token_usage().await.saturating_add(
+                step.settings
+                    .model_info
+                    .usable_context_window()
+                    .unwrap_or(0)
+                    / 10,
+            );
+            self.window_id = Some(sess.current_window_id().await);
+        }
+
+        if !allow_start
+            || self.pending.is_some()
+            || self.attempted
+            || self.failures >= 2
+            || !self.enabled()
+            || step.turn.config.features.enabled(Feature::TokenBudget)
+            || !matches!(
+                step.turn.provider.capabilities().remote_compaction,
+                RemoteCompactionSupport::V2
+            )
+            || crate::guardian::is_basic_session_source(&step.turn.session_source)
+        {
+            return Ok(installed);
+        }
+        let Some(window) = step
+            .settings
+            .model_info
+            .usable_context_window()
+            .filter(|window| *window > 0)
+        else {
+            return Ok(installed);
+        };
+        let tokens = sess.get_total_token_usage().await;
+        if tokens < window / 2 || tokens < self.next_start_tokens {
+            return Ok(installed);
+        }
+        // Hooks run on the turn owner, never concurrently inside the worker.
+        if matches!(
+            run_pre_compact_hooks(sess, &step.turn, CompactionTrigger::Auto).await,
+            PreCompactHookOutcome::Stopped
+        ) {
+            return Err(CodexErr::TurnAborted);
+        }
+        let (history, reset, window_number, window_ids) =
+            sess.background_compaction_snapshot().await;
+        let window_id = window_ids.window_id.to_string();
+        // Keep Codex's copy-on-write transcript snapshot instead of copying every
+        // message and image payload on the foreground turn.
+        let items = history.clone().into_shared_annotated_items();
+        let Some(protected_start) = protected_tail_start(&items) else {
+            return Ok(installed);
+        };
+        if protected_start == 0 {
+            return Ok(installed);
+        }
+        self.attempted = true;
+        let pinned_user_items = items[..protected_start]
+            .iter()
+            .filter(|item| is_user_turn_boundary(&item.item))
+            .rev()
+            .take(2)
+            .cloned()
+            .collect::<Vec<_>>()
+            .into_iter()
+            .rev()
+            .collect();
+        let snapshot = HistorySnapshot {
+            items,
+            protected_start,
+            reset,
+            window_id,
+            window_number,
+            window_ids,
+            max_estimated_tokens: window.saturating_mul(3) / 4,
+            fresh_context: Vec::new(),
+            pinned_user_items,
+        };
+        let worker_sess = Arc::clone(sess);
+        let worker_step = Arc::clone(step);
+        let worker_reset = snapshot.reset.clone();
+        let timeout = Duration::from_secs(60);
+        #[cfg(test)]
+        let timeout = self.timeout_for_test.unwrap_or(timeout);
+        let worker = tokio::spawn(async move {
+            let trace = worker_sess
+                .services
+                .rollout_thread_trace
+                .compaction_trace_context(
+                    worker_step.turn.sub_id.as_str(),
+                    "background",
+                    worker_step.settings.model_info.slug.as_str(),
+                    worker_step.turn.provider.info().name.as_str(),
+                );
+            let metadata = CompactionTurnMetadata::new(
+                CompactionTrigger::Auto,
+                CompactionReason::ContextLimit,
+                CompactionImplementation::ResponsesCompactionV2,
+                CompactionPhase::MidTurn,
+            );
+            let mut details = CompactionAnalyticsDetails::default();
+            let preparation = async {
+                let candidate = run_remote_compact_v2_snapshot_attempt(
+                    &worker_sess,
+                    &worker_step,
+                    None,
+                    &trace,
+                    metadata,
+                    &mut details,
+                    history,
+                )
+                .await?;
+                if let Some(usage) = &candidate.token_usage {
+                    worker_sess.record_rollout_budget_usage(usage).await?;
+                }
+                Ok(candidate)
+            };
+            // A stuck worker cannot keep the session or foreground turn alive forever.
+            tokio::select! {
+                biased;
+                _ = worker_reset.cancelled() => Err(CodexErr::TurnAborted),
+                result = tokio::time::timeout(timeout, preparation) => {
+                    match result {
+                        Ok(result) => result,
+                        Err(_) => Err(CodexErr::Fatal("background compaction timed out".to_string())),
+                    }
+                }
+            }
+        });
+        self.pending = Some(Pending {
+            snapshot,
+            step: Arc::clone(step),
+            worker,
+        });
+        info!(
+            tokens,
+            window, "background compaction preparing; foreground turn continues"
+        );
+        Ok(installed)
+    }
+
+    fn enabled(&self) -> bool {
+        #[cfg(test)]
+        if self.enabled_for_test {
+            return true;
+        }
+        std::env::var("CODEX_EXPERIMENTAL_ASYNC_COMPACTION").as_deref() == Ok("1")
+    }
+}
+
+async fn install(
+    sess: &Arc<Session>,
+    step: &Arc<StepContext>,
+    mut snapshot: HistorySnapshot,
+    candidate: PreparedRemoteCompaction,
+) -> CodexResult<bool> {
+    let (compacted_history, _) = build_v2_compacted_history(
+        candidate.prompt_input,
+        candidate.prompt_input_metadata,
+        candidate.compaction_output,
+        sess.enabled(Feature::RetainClientDeveloperMessages),
+        if sess.enabled(Feature::CompactionImageBudget) {
+            RetainedImageBudget::Enabled
+        } else {
+            RetainedImageBudget::Disabled
+        },
+    );
+    let world_state = sess.build_world_state_for_step(step, true).await?;
+    let (updates, baseline) = sess
+        .build_initial_context_with_world_state(step, &world_state)
+        .await;
+    let (prefix, context) = split_prefix_updates(updates);
+    // The preserved tail contains historic world-state deltas. Render current state
+    // after it so those historic deltas cannot override current tools or permissions.
+    snapshot.fresh_context = merge_world_state_updates(context)
+        .into_iter()
+        .map(ResponseItemEnvelope::new)
+        .collect();
+    let history = prefix
+        .into_iter()
+        .map(ResponseItemEnvelope::new)
+        .chain(compacted_history)
+        .collect();
+    let window_number = snapshot.window_number;
+    let window_ids = snapshot.window_ids;
+    let reviewer_compaction_hash = if crate::context::GuardianContextMode::from_history(
+        sess.conversation_history_snapshot().await.as_ref(),
+    ) == crate::context::GuardianContextMode::Legacy
+    {
+        let mut review_context = crate::guardian::GuardianReviewContext::from(&step.turn);
+        review_context.model_info = Arc::clone(&step.settings.model_info);
+        let (_, reviewer) = crate::guardian::resolve_review_model(sess, &review_context).await;
+        reviewer.comp_hash.clone()
+    } else {
+        None
+    };
+    let installed = sess
+        .try_replace_background_compacted_history(
+            history,
+            step.to_turn_context_item(),
+            baseline,
+            CompactedHistoryMetadata {
+                input_goal_ids: candidate.input_goal_ids,
+                message: String::new(),
+                window_number,
+                window_ids,
+                compaction_response_id: Some(candidate.compaction_response_id),
+                compaction_model_hash: step.settings.model_info.comp_hash.clone(),
+                reviewer_compaction_hash,
+            },
+            snapshot,
+        )
+        .await;
+    if installed {
+        sess.recompute_token_usage(&step.turn).await;
+        info!("background compaction installed at request boundary");
+        if matches!(
+            run_post_compact_hooks(sess, &step.turn, CompactionTrigger::Auto).await,
+            PostCompactHookOutcome::Stopped
+        ) {
+            return Err(CodexErr::TurnAborted);
+        }
+    } else {
+        info!("background compaction discarded: stale snapshot or insufficient headroom");
+    }
+    Ok(installed)
+}
+
+/// Protect recent raw items, expanding left to preserve tool-call and attached-notice pairs.
+/// Latest user directions outside this tail are separately pinned verbatim.
+pub(crate) fn protected_tail_start(items: &[ResponseItemEnvelope]) -> Option<usize> {
+    let cutoff = items.len().saturating_sub(24);
+    let mut offset = 0usize;
+    let mut start = 0usize;
+    for group in
+        crate::compact_remote_history::history_item_groups(items.iter().map(|item| &item.item))
+    {
+        let length = 1 + usize::from(group.attached_notice.is_some());
+        if offset <= cutoff && cutoff < offset + length {
+            start = offset;
+            break;
+        }
+        offset += length;
+    }
+    let mut calls = HashMap::new();
+    let mut pairs = Vec::new();
+    for (index, item) in items.iter().enumerate() {
+        match &item.item {
+            ResponseItem::FunctionCall { call_id, .. }
+            | ResponseItem::CustomToolCall { call_id, .. } => {
+                if calls.insert(call_id.as_str(), index).is_some() {
+                    return None;
+                }
+            }
+            ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::ToolSearchCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                if calls.insert(call_id.as_str(), index).is_some() {
+                    return None;
+                }
+            }
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::ToolSearchOutput {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput { call_id, .. } => {
+                let call = calls.remove(call_id.as_str())?;
+                pairs.push((call, index));
+            }
+            _ => {}
+        }
+    }
+    if !calls.is_empty() {
+        return None;
+    }
+    loop {
+        let expanded = pairs
+            .iter()
+            .filter(|(_, output)| *output >= start)
+            .map(|(call, _)| *call)
+            .fold(start, usize::min);
+        if expanded == start {
+            break;
+        }
+        start = expanded;
+    }
+    Some(start)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::protected_tail_start;
+    use codex_history::ResponseItemEnvelope;
+    use serde_json::json;
+
+    fn item(value: serde_json::Value) -> ResponseItemEnvelope {
+        ResponseItemEnvelope::new(serde_json::from_value(value).expect("valid test item"))
+    }
+
+    fn messages() -> Vec<ResponseItemEnvelope> {
+        (0..40)
+            .map(|index| {
+                item(json!({
+                    "type": "message", "role": "assistant",
+                    "content": [{"type": "output_text", "text": format!("phase {index}")}]
+                }))
+            })
+            .collect()
+    }
+
+    fn call(id: &str) -> ResponseItemEnvelope {
+        item(json!({"type": "function_call", "name": "test", "arguments": "{}", "call_id": id}))
+    }
+
+    fn output(id: &str) -> ResponseItemEnvelope {
+        item(json!({"type": "function_call_output", "call_id": id, "output": "done"}))
+    }
+
+    #[test]
+    fn protects_tool_pairs_transitively_across_the_tail_boundary() {
+        let mut history = messages();
+        history[1] = call("earlier");
+        history[3] = output("earlier");
+        history[2] = call("crossing");
+        history[30] = output("crossing");
+        assert_eq!(protected_tail_start(&history), Some(1));
+    }
+
+    #[test]
+    fn rejects_unfinished_or_orphaned_tool_exchanges() {
+        let mut history = messages();
+        history[5] = call("unfinished");
+        assert_eq!(protected_tail_start(&history), None);
+        history[5] = output("orphan");
+        assert_eq!(protected_tail_start(&history), None);
+    }
+
+    #[test]
+    fn rejects_ambiguous_outstanding_call_ids() {
+        let mut history = messages();
+        history[5] = call("duplicate");
+        history[6] = call("duplicate");
+        history[30] = output("duplicate");
+        assert_eq!(protected_tail_start(&history), None);
+    }
+}
diff --git a/codex-rs/core/src/compact_background_merge.rs b/codex-rs/core/src/compact_background_merge.rs
new file mode 100644
index 0000000..031093b
--- /dev/null
+++ b/codex-rs/core/src/compact_background_merge.rs
@@ -0,0 +1,100 @@
+//! Pure compare-and-merge logic, also executable with `rustc --test` outside the workspace.
+
+/// Preserve the protected snapshot tail and every subsequently appended item exactly once.
+/// Any edit, truncation, reset, or competing compaction makes the candidate obsolete.
+pub(crate) fn merge<T: Clone + PartialEq>(
+    snapshot: &[T],
+    live: &[T],
+    replacement: Vec<T>,
+    protected_start: usize,
+    same_identity: impl Fn(&T, &T) -> bool,
+) -> Option<Vec<T>> {
+    if protected_start > snapshot.len() || !live.starts_with(snapshot) {
+        return None;
+    }
+    let tail = &live[protected_start..];
+    let mut merged = replacement
+        .into_iter()
+        .filter(|item| !tail.iter().any(|retained| same_identity(item, retained)))
+        .collect::<Vec<_>>();
+    merged.extend_from_slice(tail);
+    Some(merged)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::merge;
+
+    #[test]
+    fn preserves_user_steering_and_tool_results_appended_during_compaction() {
+        let snapshot = vec!["old", "user", "call", "result"];
+        let live = vec![
+            "old",
+            "user",
+            "call",
+            "result",
+            "correction",
+            "new call",
+            "new result",
+        ];
+        assert_eq!(
+            merge(
+                &snapshot,
+                &live,
+                vec!["summary", "user", "result"],
+                1,
+                |a, b| a == b
+            ),
+            Some(vec![
+                "summary",
+                "user",
+                "call",
+                "result",
+                "correction",
+                "new call",
+                "new result"
+            ])
+        );
+    }
+
+    #[test]
+    fn rejects_reset_native_compaction_and_history_edits() {
+        for live in [
+            vec!["reset"],
+            vec!["other summary", "user"],
+            vec!["edited", "user"],
+        ] {
+            assert_eq!(
+                merge(&["old", "user"], &live, vec!["summary"], 1, |a, b| a == b),
+                None
+            );
+        }
+    }
+
+    #[test]
+    fn preserves_order_and_duplicate_appends_without_deduplicating_live_tail() {
+        assert_eq!(
+            merge(&[1, 2], &[1, 2, 3, 3, 4], vec![0, 2], 1, |a, b| a == b),
+            Some(vec![0, 2, 3, 3, 4])
+        );
+    }
+
+    #[test]
+    fn retained_metadata_can_change_without_duplicating_item_identity() {
+        assert_eq!(
+            merge(
+                &[(1, "old"), (2, "live")],
+                &[(1, "old"), (2, "live")],
+                vec![(0, "summary"), (2, "rewritten")],
+                1,
+                |a, b| a.0 == b.0
+            ),
+            Some(vec![(0, "summary"), (2, "live")])
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_protected_boundary() {
+        assert_eq!(merge(&[1], &[1], vec![0], 2, |a, b| a == b), None);
+    }
+}
