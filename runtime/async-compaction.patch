+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compact_background_keeps_foreground_progress(
+    stale: bool,
+    remote_failure: bool,
+    times_out: bool,
+) {
+    let _ = tracing_subscriber::fmt()
+        .with_env_filter("codex_core::compact_background=info,codex_core::session=info")
+        .try_init();
+    let server = responses::start_mock_server().await;
+    let mut provider = built_in_model_providers(None)["openai"].clone();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    provider.request_max_retries = Some(0);
+    provider.stream_max_retries = Some(0);
+    let (session, turn, _events) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+        Vec::new(),
+        |config| {
+            config.model = Some("gpt-5.2".to_string());
+            config.model_context_window = Some(100_000);
+            config.model_provider = provider;
+            config.chatgpt_base_url = server.uri();
+            let _ = config.features.disable(Feature::TokenBudget);
+        },
+    )
+    .await;
+    let response = ResponseTemplate::new(if remote_failure { 500 } else { 200 })
+        .insert_header("content-type", "text/event-stream")
+        .set_delay(Duration::from_secs(2))
+        .set_body_string(responses::sse(vec![
+            json!({"type": "response.output_item.done", "item": {
+                "type": "compaction", "encrypted_content": "BACKGROUND_SUMMARY"
+            }}),
+            responses::ev_completed("background-response"),
+        ]));
+    let requests = responses::mount_response_once(&server, response).await;
+    let mut items = vec![user_message("Keep my uncommitted changes; do not deploy.")];
+    items.extend(
+        (0..60).map(|index| {
+            assistant_message(&format!("Completed phase {index}: {}", "x".repeat(4000)))
+        }),
+    );
+    session
+        .record_conversation_items(&turn, turn.model_info(), &items)
+        .await;
+    session.recompute_token_usage(&turn).await;
+    let step = session
+        .capture_speculative_step_context(Arc::clone(&turn), &CancellationToken::new())
+        .await
+        .expect("capture step");
+    let controller = Arc::clone(&session.state.lock().await.background_compaction);
+    controller.lock().await.enabled_for_test = true;
+    if times_out {
+        controller.lock().await.timeout_for_test = Some(Duration::from_millis(500));
+    }
+    let initial_window = session.current_window_id().await;
+    let before = session.clone_history().await.annotated_items().to_vec();
+    assert!(
+        session.get_total_token_usage().await
+            >= step
+                .settings
+                .model_info
+                .usable_context_window()
+                .expect("window")
+                / 2,
+        "fixture below threshold: tokens={}, window={:?}",
+        session.get_total_token_usage().await,
+        step.settings.model_info.usable_context_window()
+    );
+    assert!(!step.turn.config.features.enabled(Feature::TokenBudget));
+    assert!(matches!(
+        step.turn.provider.capabilities().remote_compaction,
+        codex_model_provider::RemoteCompactionSupport::V2
+    ));
+
+    // A 2-second remote worker must not hold this foreground request boundary.
+    assert!(
+        !timeout(
+            Duration::from_millis(750),
+            controller.lock().await.at_request_boundary(&session, &step)
+        )
+        .await
+        .expect("foreground waited on worker")
+        .expect("start preparation")
+    );
+    assert!(
+        controller.lock().await.is_preparing(),
+        "worker never started"
+    );
+    assert_eq!(
+        session.clone_history().await.annotated_items(),
+        before.as_slice()
+    );
+    if stale {
+        session
+            .replace_history(
+                vec![user_message("New objective replaces the old task.")],
+                None,
+            )
+            .await;
+    } else {
+        session
+            .record_conversation_items(
+                &turn,
+                turn.model_info(),
+                &[
+                    user_message("Correction: use the existing branch."),
+                    assistant_message("Foreground work finished while compaction was pending."),
+                ],
+            )
+            .await;
+    }
+    let live_tail = session.clone_history().await.annotated_items().to_vec();
+    assert!(
+        !timeout(
+            Duration::from_millis(750),
+            controller.lock().await.at_request_boundary(&session, &step)
+        )
+        .await
+        .expect("foreground waited on pending worker")
+        .expect("continue work")
+    );
+    assert_eq!(
+        session.clone_history().await.annotated_items(),
+        live_tail.as_slice()
+    );
+
+    if remote_failure || times_out {
+        timeout(Duration::from_secs(10), async {
+            loop {
+                let mut background = controller.lock().await;
+                assert!(
+                    !background
+                        .at_request_boundary(&session, &step)
+                        .await
+                        .expect("poll failure")
+                );
+                if !background.is_preparing() {
+                    break;
+                }
+                drop(background);
+                sleep(Duration::from_millis(20)).await;
+            }
+        })
+        .await
+        .expect("failed worker never retired");
+        assert_eq!(
+            session.clone_history().await.annotated_items(),
+            live_tail.as_slice()
+        );
+        assert_eq!(session.current_window_id().await, initial_window);
+    } else if stale {
+        assert_eq!(session.current_window_id().await, initial_window);
+        assert_eq!(
+            session.clone_history().await.annotated_items(),
+            live_tail.as_slice()
+        );
+    } else {
+        let publication = timeout(Duration::from_secs(15), async {
+            loop {
+                if controller
+                    .lock()
+                    .await
+                    .at_request_boundary(&session, &step)
+                    .await
+                    .expect("publish candidate")
+                {
+                    break;
+                }
+                sleep(Duration::from_millis(20)).await;
+            }
+        })
+        .await;
+        assert!(
+            publication.is_ok(),
+            "candidate never installed: preparing={}, requests={}",
+            controller.lock().await.is_preparing(),
+            requests.requests().len()
+        );
+        let installed = session.clone_history().await;
+        assert_ne!(session.current_window_id().await, initial_window);
+        for expected in live_tail.iter().rev().take(24) {
+            assert_eq!(
+                installed
+                    .annotated_items()
+                    .iter()
+                    .filter(|item| item.item.id() == expected.item.id())
+                    .count(),
+                1
+            );
+        }
+        assert!(
+            installed
+                .raw_items()
+                .any(|item| matches!(item, ResponseItem::Compaction { .. }))
+        );
+        assert!(installed.annotated_items().len() < before.len());
+        assert!(installed.raw_items().any(|item| {
+            matches!(item, ResponseItem::Message { role, content, .. }
+                if role == "user" && content.iter().any(|part|
+                    matches!(part, ContentItem::InputText { text }
+                        if text == "Keep my uncommitted changes; do not deploy.")))
+        }));
+        assert_eq!(requests.requests().len(), 1);
+    }
+    controller.lock().await.cancel();
+}
